[Unit]
Description=Back up Love Story SQLite data and uploaded photos

[Service]
Type=oneshot
User=love-story
Group=love-story
Environment=DATA_DIR=/var/lib/love-story
Environment=BACKUP_DIR=/var/backups/love-story
Environment=RETENTION_DAYS=14
# Freeze application writes so the database and photo archive describe the
# same restore point. The privileged commands are limited to service control;
# the backup itself still runs as the unprivileged account.
ExecStartPre=+/usr/bin/systemctl stop love-story.service
ExecStart=/usr/local/sbin/love-story-backup
ExecStartPost=+/usr/bin/systemctl start love-story.service
ExecStopPost=+/usr/bin/systemctl start love-story.service
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/love-story
ReadWritePaths=/var/backups/love-story
MemoryMax=128M
