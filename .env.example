# Copy this file to /etc/love-story/love-story.env for production.
# It uses systemd EnvironmentFile syntax: one KEY=value pair per line.
# Never commit the real file. Replace every REPLACE_* value before first start.

DATA_DIR=/var/lib/love-story
ADMIN_PASSWORD=REPLACE_WITH_A_NEW_LONG_RANDOM_PASSWORD_BEFORE_FIRST_START
PUBLIC_ORIGIN=https://love.example.com
TRUSTED_HOSTS=love.example.com,www.love.example.com,127.0.0.1
COOKIE_SECURE=true
SESSION_HOURS=12

# Keep these aligned with Nginx. MAX_REQUEST_BODY_BYTES includes multipart
# framing; MAX_UPLOAD_BYTES is the raw image payload limit.
MAX_REQUEST_BODY_BYTES=6291456
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=16000000

# Temporary compatibility values for a server that has only a public IP and
# plain HTTP. Replace SERVER_PUBLIC_IP, choose these three values together, and
# move to the HTTPS values above as soon as a domain and certificate exist.
# PUBLIC_ORIGIN=http://SERVER_PUBLIC_IP
# TRUSTED_HOSTS=SERVER_PUBLIC_IP,127.0.0.1
# COOKIE_SECURE=false
